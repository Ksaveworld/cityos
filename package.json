{
  "name": "cityos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test:chat": "node --test server/chat-core.test.ts",
    "test:backend": "node --test server/cityos/*.test.ts",
    "db:up": "docker compose -f services/postgres/docker-compose.yml up -d",
    "db:down": "docker compose -f services/postgres/docker-compose.yml down",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:import-public-poi": "node scripts/db-import-public-poi.mjs",
    "db:smoke": "node scripts/db-smoke.mjs",
    "auth:provision": "node scripts/auth-provision.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deck.gl/geo-layers": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/mapbox": "^9.3.10",
    "@vercel/functions": "3.9.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deck.gl": "^9.3.10",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.4.0",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
